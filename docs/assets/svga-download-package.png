<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1985ef;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#33d1ac;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="300" rx="20" fill="url(#grad)"/>
  <text x="200" y="120" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="white" text-anchor="middle">SVGA</text>
  <text x="200" y="180" font-family="Arial, sans-serif" font-size="24" fill="white" text-anchor="middle">Viewer Plugin</text>
  <text x="200" y="220" font-family="Arial, sans-serif" font-size="16" fill="rgba(255,255,255,0.8)" text-anchor="middle">for QuickLook</text>
</svg>